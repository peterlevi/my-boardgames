{
  "id": "azul",
  "name": "Azul",
  "inspiredBy": "Azul",
  "dark": false,
  "gfont": "Playfair+Display:wght@700",
  "face": {
    "palette": ["#1f4fa0", "#f3ecdc", "#2a8f96", "#e2a137", "#13305f", "#b83a2e"],
    "seam": "#f3ecdc",
    "ink": "contrast",
    "glow": "rgba(19,48,95,.25)",
    "font": "700 {px} \"Playfair Display\",Georgia,serif",
    "sep": "#13305f",
    "sepW": 1.2,
    "rim": "lapis",
    "pins": "gilt",
    "hub": "pearl",
    "mark": {"color": "#14100c", "glow": "rgba(242,194,92,.95)", "width": 3},
    "stick": ["#13305f", "#f6f2e7", "rgba(10,20,40,.7)"]
  },
  "count": ["#ffffff", "#f2c25c", "#7fd3d6"],
  "word": ["#f6f2e7", "#f2c25c", "#7fd3d6", "#f08a74"],
  "flash": "#ffd56b",
  "lights": null,
  "approach": false,
  "thumb": "linear-gradient(180deg,#1f4fa0 0%,#163a7a 55%,#e2a137 67%,#f1eadb 70%,#e5dac4 100%)",
  "vars": {
    "--show-font": "\"Playfair Display\",Georgia,serif",
    "--show-weight": "700",
    "--show-case": "none",
    "--show-track": ".03em",
    "--show-glow": "0 .5cqw 0 rgba(19,48,95,.9), 0 0 .8cqw rgba(19,48,95,.8), 0 0 4cqw rgba(19,48,95,.55)",
    "--pill-bg": "#f6f2e7",
    "--pill-ink": "#13305f",
    "--pill-edge": "#1f4fa0",
    "--pill-glow": "#e2a137",
    "--ui-font": "\"Playfair Display\",Georgia,serif",
    "--lc-text": "#13305f",
    "--lc-accent": "#1f4fa0",
    "--lc-btn-bg": "#1f4fa0",
    "--lc-btn-ink": "#f6f2e7",
    "--lc-btn-edge": "#13305f",
    "--lc-field-bg": "rgba(255,252,244,.88)",
    "--lc-field-edge": "#9fb3d6"
  }
}

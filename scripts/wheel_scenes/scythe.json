{
  "id": "scythe",
  "name": "Scythe",
  "inspiredBy": "Scythe",
  "dark": false,
  "gfont": "Alegreya:wght@700",
  "face": {
    "palette": ["#c08a3e", "#6f8584", "#9a2a1e", "#dcc58a", "#4a3826", "#b5602c", "#8c8f88"],
    "seam": "#6f6b3e",
    "ink": "contrast",
    "glow": "rgba(40,30,20,.3)",
    "font": "700 {px} \"Alegreya\",Georgia,serif",
    "sep": "#3b2f24",
    "sepW": 1.1,
    "rim": "iron",
    "pins": "bronze",
    "hub": {"fill": "#9a2a1e", "ring": "#3b2f24", "glow": "#e6d3a8"},
    "mark": {"color": "#fff3d6", "glow": "rgba(30,20,12,.9)", "width": 4},
    "stick": ["#3b2f24", "#9a2a1e", "rgba(30,20,12,.8)"]
  },
  "count": ["#9a2a1e", "#3b2f24", "#b5602c"],
  "word": ["#9a2a1e", "#8a5a22", "#4f6766", "#6f6b3e"],
  "flash": "#9a2a1e",
  "lights": null,
  "approach": false,
  "thumb": "linear-gradient(180deg,#9fb0ad 0%,#c9cbbd 38%,#b9a26a 55%,#c08a3e 62%,#b8a682 75%,#a89c84 100%)",
  "vars": {
    "--show-font": "\"Alegreya\",Georgia,serif",
    "--show-weight": "700",
    "--show-case": "none",
    "--show-track": ".02em",
    "--show-glow": "0 .4cqw 0 rgba(246,240,226,.9), 0 0 2.5cqw rgba(240,232,214,.85), 0 0 5cqw rgba(240,232,214,.65)",
    "--pill-bg": "#3b2f24",
    "--pill-ink": "#f1e4c8",
    "--pill-edge": "#9a2a1e",
    "--pill-glow": "#d8cfb8",
    "--ui-font": "\"Alegreya\",Georgia,serif",
    "--lc-text": "#2e241a",
    "--lc-accent": "#9a2a1e",
    "--lc-btn-bg": "#9a2a1e",
    "--lc-btn-ink": "#f8efdc",
    "--lc-btn-edge": "#5e180f",
    "--lc-field-bg": "rgba(248,242,228,.86)",
    "--lc-field-edge": "#6b5a40"
  }
}

{
  "id": "agricola",
  "name": "Agricola",
  "inspiredBy": "Agricola",
  "dark": false,
  "gfont": "Alegreya:wght@700",
  "face": {
    "palette": ["#e3c46a", "#6f8a44", "#b5462a", "#efe3c6", "#8a5a3a", "#9bb46a"],
    "ink": "contrast",
    "glow": "rgba(46,31,18,.3)",
    "font": "700 {px} \"Alegreya\",Georgia,serif",
    "sep": "#3e2a1a",
    "sepW": 1.4,
    "rim": {"color": "#4a3020", "width": 0.018, "glow": "#e3c46a"},
    "pins": "bronze",
    "hub": {"fill": "#6e4426", "ring": "#e3c46a", "glow": "#f1e6cc"},
    "mark": {"color": "#2e1f12", "glow": "rgba(255,246,220,.95)", "width": 4},
    "stick": ["#4a3020", "#e3c46a", "rgba(46,31,18,.7)"]
  },
  "count": ["#b5462a", "#fff3d6", "#6f8a44"],
  "word": ["#b5462a", "#6f8a44", "#a8742c", "#4a3020", "#8a5a3a"],
  "flash": "#fff3d6",
  "lights": null,
  "approach": false,
  "thumb": "linear-gradient(180deg,#e8d3a2 0%,#b8bf86 22%,#e3c46a 40%,#9bb46a 58%,#f1e6cc 72%,#efe3c6 100%)",
  "vars": {
    "--show-font": "\"Alegreya\",Georgia,serif",
    "--show-weight": "700",
    "--show-case": "none",
    "--show-track": ".02em",
    "--show-glow": "0 .6cqw 0 #3e2a1a, 0 0 1.2cqw rgba(46,31,18,.85), 0 0 5cqw rgba(46,31,18,.55)",
    "--pill-bg": "#4a3020",
    "--pill-ink": "#f1e6cc",
    "--pill-edge": "#2e1f12",
    "--pill-glow": "rgba(227,196,106,.5)",
    "--ui-font": "\"Alegreya\",Georgia,serif",
    "--lc-text": "#3e2a1a",
    "--lc-accent": "#b5462a",
    "--lc-btn-bg": "#6e4426",
    "--lc-btn-ink": "#f8efd6",
    "--lc-btn-edge": "#3e2a1a",
    "--lc-field-bg": "rgba(255,250,236,.88)",
    "--lc-field-edge": "#b89a6e"
  }
}

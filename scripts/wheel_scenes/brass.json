{
  "id": "brass",
  "name": "Lancashire",
  "inspiredBy": "Brass: Lancashire",
  "dark": true,
  "gfont": "Old+Standard+TT:wght@700",
  "face": {
    "palette": [
      "#7a1f1f",
      "#e6cf9c",
      "#2b2421",
      "#c9973f",
      "#5c3a2a"
    ],
    "seam": "#a5482c",
    "ink": "contrast",
    "glow": "rgba(15,10,8,.4)",
    "font": "700 {px} \"Old Standard TT\",Georgia,serif",
    "sep": "#15100e",
    "sepW": 1.3,
    "rim": "brass",
    "pins": "brass",
    "hub": "brass",
    "mark": {
      "color": "#ffe6a8",
      "glow": "rgba(255,190,100,.9)",
      "width": 3
    },
    "stick": [
      "#3a2a20",
      "#d6a858",
      "rgba(15,10,8,.9)"
    ]
  },
  "count": [
    "#f3d27a",
    "#e8a45a",
    "#fff0cc"
  ],
  "word": [
    "#f3d27a",
    "#d6a858",
    "#e8d3a8",
    "#c86a3a"
  ],
  "flash": "#ffe6a8",
  "lights": {
    "idle": 0.5,
    "spin": 0.18,
    "focus": 0.66,
    "out": 0.62

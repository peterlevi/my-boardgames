{
  "id": "container",
  "name": "Container",
  "inspiredBy": "Container",
  "dark": true,
  "gfont": "Saira+Stencil+One",
  "face": {
    "palette": ["#c8572a", "#e3b04b", "#5b3a6b", "#efe3c8", "#2f6f73", "#8a4a2b", "#3d5a80"],
    "seam": "#20262e",
    "ink": "contrast",
    "glow": "rgba(10,16,24,.4)",
    "font": "400 {px} \"Saira Stencil One\",\"Arial Narrow\",sans-serif",
    "sep": "#141a22",
    "sepW": 1.6,
    "rim": "iron",
    "pins": "chrome",
    "hub": "iron",
    "mark": {"color": "#ffe4a8", "glow": "rgba(255,170,80,.9)", "width": 3},
    "stick": ["#7a2c12", "#e86a2e", "rgba(10,16,24,.85)"]
  },
  "count": ["#ffb36a", "#efe3c8", "#e3b04b"],
  "word": ["#ffb36a", "#efe3c8", "#e3b04b", "#9fd2d4"],
  "flash": "#ffe4a8",
  "lights": {"idle": 0.4, "spin": 0.12, "focus": 0.6, "out": 0.55},
  "approach": true,
  "thumb": "linear-gradient(180deg,#3a2c4f 0%,#c8572a 38%,#e3b04b 52%,#2f6f73 70%,#1d2b45 100%)",
  "vars": {
    "--show-font": "\"Saira Stencil One\",\"Arial Narrow\",sans-serif",
    "--show-weight": "400",
    "--show-case": "uppercase",
    "--show-track": ".05em",
    "--show-glow": "0 .6cqw 0 rgba(12,18,28,.85), 0 0 4cqw rgba(12,18,28,.75)",
    "--pill-bg": "#1d2b45",
    "--pill-ink": "#ffd9a0",
    "--pill-edge": "#e86a2e",
    "--pill-glow": "#e86a2e",
    "--ui-font": "\"Saira Stencil One\",\"Arial Narrow\",sans-serif",
    "--sc-text": "#f2e8d4",
    "--sc-icon": "#e3b04b",
    "--sc-accent": "#ff9a52",
    "--sc-accent2": "#ffd9a0",
    "--sc-muted": "#b6a68e",
    "--sc-glow": "rgba(232,106,46,.45)",
    "--sc-btn-a": "#d0602c",
    "--sc-btn-b": "#8a3a1a",
    "--sc-btn-edge": "#ffd9a0",
    "--sc-btn-ink": "#fff6e6",
    "--shade-rgb": "12, 18, 28",
    "--pool-a": "255, 200, 140",
    "--pool-b": "232, 106, 46",
    "--halo": "rgba(255,170,90,.35)",
    "--scrim-rgb": "14, 20, 30"
  }
}

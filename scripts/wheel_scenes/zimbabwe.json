{
  "id": "zimbabwe",
  "name": "Great Zimbabwe",
  "inspiredBy": "The Great Zimbabwe",
  "dark": true,
  "gfont": "Philosopher:wght@700",
  "face": {
    "palette": ["#b4532a", "#f1d29b", "#4f2412", "#e39538", "#8a3d1d", "#d9b26a"],
    "seam": "#6a3018",
    "ink": "contrast",
    "glow": "rgba(30,12,6,.45)",
    "font": "700 {px} \"Philosopher\",Georgia,serif",
    "sep": "#2a110a",
    "sepW": 1.4,
    "rim": "bronze",
    "pins": "copper",
    "hub": "bronze",
    "mark": {"color": "#fff1c8", "glow": "rgba(255,190,90,.9)", "width": 3},
    "stick": ["#5a2a14", "#e0a040", "rgba(30,12,6,.9)"]
  },
  "count": ["#ffd98a", "#f08a34", "#fff1c8"],
  "word": ["#ffd98a", "#f08a34", "#f3dcae", "#e0a040"],
  "flash": "#fff1c8",
  "lights": {"idle": 0.4, "spin": 0.12, "focus": 0.6, "out": 0.55},
  "approach": true,
  "thumb": "linear-gradient(180deg, #2b120c 0%, #9c3f1a 34%, #f2a548 56%, #7a3115 68%, #1c0d07 100%)",
  "vars": {
    "--show-font": "\"Philosopher\",Georgia,serif",
    "--show-weight": "700",
    "--show-case": "uppercase",
    "--show-track": ".06em",
    "--show-glow": "0 .6cqw 0 rgba(30,12,6,.75), 0 0 4cqw rgba(30,12,6,.7)",
    "--pill-bg": "#2a130a",
    "--pill-ink": "#ffe2a6",
    "--pill-edge": "#e0a040",
    "--pill-glow": "#f08a34",
    "--ui-font": "\"Philosopher\",Georgia,serif",
    "--sc-text": "#f6e3c0",
    "--sc-icon": "#e0a040",
    "--sc-accent": "#f08a34",
    "--sc-accent2": "#ffd98a",
    "--sc-muted": "#b98a62",
    "--sc-glow": "rgba(240,138,52,.45)",
    "--sc-btn-a": "#c2622a",
    "--sc-btn-b": "#8a3d1d",
    "--sc-btn-edge": "#ffd98a",
    "--sc-btn-ink": "#fff4dc",
    "--shade-rgb": "28, 12, 6",
    "--pool-a": "255, 200, 120",
    "--pool-b": "240, 138, 52",
    "--halo": "rgba(255,200,120,.35)"
  }
}

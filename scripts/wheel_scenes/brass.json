    "--pill-bg": "#1f1714",
    "--pill-ink": "#f3d27a",
    "--pill-edge": "#b8862e",
    "--pill-glow": "#e8a45a",
    "--ui-font": "\"Old Standard TT\",Georgia,serif",
    "--sc-text": "#efe0c0",
    "--sc-icon": "#d6a858",
    "--sc-accent": "#e8a45a",
    "--sc-accent2": "#f3d27a",
    "--sc-muted": "#a08870",
    "--sc-glow": "rgba(232,164,90,.4)",
    "--sc-btn-a": "#8a2a24",
    "--sc-btn-b": "#5a1616",
    "--sc-btn-edge": "#d6a858",
    "--sc-btn-ink": "#fff0d6",
    "--shade-rgb": "10, 8, 7",
    "--pool-a": "255, 214, 144",
    "--pool-b": "232, 164, 90",
    "--halo": "rgba(242,183,100,.32)",
    "--scrim-rgb": "10, 8, 7"

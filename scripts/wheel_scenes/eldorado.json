{
  "id": "eldorado",
  "name": "El Dorado",
  "inspiredBy": "The Quest for El Dorado",
  "dark": true,
  "gfont": "Cinzel+Decorative:wght@700",
  "face": {
    "palette": ["#1f7a4d", "#e2ad3a", "#145a63", "#b8552f", "#3fa08a", "#ecd9a6"],
    "seam": "#8c5a2b",
    "ink": "contrast",
    "glow": "rgba(8,30,24,.4)",
    "font": "700 {px} \"Cinzel Decorative\",Georgia,serif",
    "sep": "#0e2e24",
    "sepW": 1.2,
    "rim": "gilt",
    "pins": "brass",
    "hub": "jade",
    "mark": {"color": "#fff4c2", "glow": "rgba(255,214,90,.95)", "width": 3},
    "stick": ["#7a4a12", "#f2cf6a", "rgba(20,10,0,.75)"]
  },
  "count": ["#ffe08a", "#f6b04a", "#7fe0c0"],
  "word": ["#ffd86b", "#7fe0c0", "#f39a5c", "#bdeb7a"],
  "flash": "#ffe38a",
  "lights": null,
  "approach": false,

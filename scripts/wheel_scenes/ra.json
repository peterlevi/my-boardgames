{
  "id": "ra",
  "name": "Ra",
  "inspiredBy": "Ra",
  "dark": true,
  "gfont": "Cinzel:wght@700",
  "face": {
    "palette": ["#1d3c96", "#e0b04a", "#1f8f86", "#b5402c", "#ecd7a0", "#14276b"],
    "seam": "#c9772f",
    "ink": "contrast",
    "glow": "rgba(10,16,48,.45)",
    "font": "700 {px} \"Cinzel\",Georgia,serif",
    "sep": "#f2d27a",
    "sepW": 1.4,
    "rim": "gilt",
    "pins": "gilt",
    "hub": "lapis",
    "mark": {"color": "#5ff5e6", "glow": "rgba(95,245,230,.85)", "width": 3},
    "stick": ["#8f5d14", "#f7dc8a", "rgba(10,16,48,.85)"]
  },
  "count": ["#f7dc8a", "#5fe0d2", "#ff9a6a"],
  "word": ["#f7dc8a", "#7fb2ff", "#5fe0d2", "#ff9a6a"],
  "flash": "#ffe08a",
  "lights": {"idle": 0.4, "spin": 0.15, "focus": 0.6, "out": 0.55},
  "approach": true,
  "thumb": "linear-gradient(180deg,#050d33 0%,#22408f 40%,#b9695a 58%,#f2bc55 64%,#0d153e 72%,#091031 100%)",
  "vars": {
    "--show-font": "\"Cinzel\",Georgia,serif",
    "--show-weight": "700",
    "--show-case": "uppercase",
    "--show-track": ".08em",
    "--show-glow": "0 .5cqw 0 rgba(10,16,48,.85), 0 0 3cqw rgba(246,196,90,.55), 0 0 6cqw rgba(10,16,48,.6)",
    "--pill-bg": "#0f2a78",
    "--pill-ink": "#f7dc8a",
    "--pill-edge": "#e2b34e",
    "--pill-glow": "#f0c45a",
    "--ui-font": "\"Cinzel\",Georgia,serif",
    "--sc-text": "#f3e6c4",
    "--sc-icon": "#f0c45a",
    "--sc-accent": "#f0c45a",
    "--sc-accent2": "#5fe0d2",
    "--sc-muted": "#9aa6cc",
    "--sc-glow": "rgba(240,196,90,.45)",
    "--sc-btn-a": "#ecc35e",
    "--sc-btn-b": "#a8761e",
    "--sc-btn-edge": "#fbe3a0",
    "--sc-btn-ink": "#0b1338",
    "--shade-rgb": "6, 12, 40",
    "--pool-a": "240, 196, 90",
    "--pool-b": "95, 224, 210",
    "--halo": "rgba(246,215,122,.35)"
  }
}

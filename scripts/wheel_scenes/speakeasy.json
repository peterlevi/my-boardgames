{
  "id": "speakeasy",
  "name": "Speakeasy",
  "inspiredBy": "1920s Prohibition-era gangster board games",
  "dark": true,
  "gfont": "Josefin+Sans:wght@700",
  "face": {
    "palette": ["#0f5c43", "#14110d", "#c9a24a", "#1d7a5a", "#2a2118", "#e8d9b0"],
    "ink": "contrast",
    "glow": "rgba(0,0,0,.45)",
    "font": "700 {px} \"Josefin Sans\",\"Avenir Next\",sans-serif",
    "sep": "#c9a24a",
    "sepW": 1.4,
    "rim": "brass",
    "pins": "gilt",
    "hub": "brass",
    "mark": {"color": "#fdf4d0", "glow": "rgba(229,195,90,.95)", "width": 3.5},
    "stick": ["#7a5c22", "#e5c35a", "rgba(0,0,0,.75)"]
  },
  "count": ["#e5c35a", "#f6ead0", "#4fd1a0"],
  "word": ["#e5c35a", "#f6ead0", "#4fd1a0", "#c9a24a", "#f3d77e"],
  "flash": "#f3d77e",
  "lights": {"idle": 0.5, "spin": 0.18, "focus": 0.66, "out": 0.62},
  "approach": true,
  "thumb": "radial-gradient(ellipse 90% 70% at 50% 40%, #1d4a38 0%, #10261d 50%, #070b09 100%)",
  "vars": {
    "--show-font": "\"Josefin Sans\",\"Avenir Next\",sans-serif",
    "--show-weight": "700",
    "--show-case": "uppercase",
    "--show-track": ".12em",
    "--show-glow": "0 .6cqw 0 rgba(0,0,0,.7), 0 0 2cqw rgba(0,0,0,.8), 0 0 6cqw rgba(229,195,90,.45)",
    "--pill-bg": "#070b09",
    "--pill-ink": "#f3d77e",
    "--pill-edge": "#c9a24a",
    "--pill-glow": "#c9a24a",
    "--ui-font": "\"Josefin Sans\",\"Avenir Next\",sans-serif",
    "--sc-text": "#f2e6c8",
    "--sc-icon": "#e3d3a8",
    "--sc-accent": "#e5c35a",
    "--sc-accent2": "#4fd1a0",
    "--sc-muted": "#b9c7bd",
    "--sc-glow": "rgba(229,195,90,.35)",
    "--sc-btn-a": "#127050",
    "--sc-btn-b": "#073626",
    "--sc-btn-edge": "#c9a24a",
    "--sc-btn-ink": "#f6ead0",
    "--shade-rgb": "4, 12, 8",
    "--pool-a": "255, 228, 170",
    "--pool-b": "255, 244, 214",
    "--halo": "rgba(229,195,90,.22)"
  }
}

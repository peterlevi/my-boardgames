{
  "id": "harmonies",
  "name": "Harmonies",
  "inspiredBy": "Harmonies",
  "dark": false,
  "gfont": "Fredoka:wght@700",
  "face": {
    "palette": ["#2a9d8f", "#f2c84b", "#5bb6e0", "#f08a3c", "#6cbf5a", "#ef6f6c", "#8e6bbf"],
    "ink": "contrast",
    "glow": "rgba(0,0,0,.18)",
    "font": "700 {px} \"Fredoka\",\"Avenir Next\",sans-serif",
    "sep": "#fdf8ec",
    "sepW": 2.2,
    "rim": {"color": "#2f6f9f", "width": 0.018, "glow": "#bfe3f2"},
    "pins": {"color": "#fdf8ec", "glow": "#2f6f9f"},
    "hub": {"fill": "#f2c84b", "ring": "#f08a3c", "glow": "#fff3c4"},
    "mark": {"color": "#1f3b5a", "glow": "rgba(255,255,255,.95)", "width": 4},
    "stick": ["#2f6f9f", "#5bb6e0", "rgba(20,40,60,.55)"]
  },
  "count": ["#f08a3c", "#2a9d8f", "#8e6bbf"],
  "word": ["#2a9d8f", "#f2a93b", "#3b9fd1", "#f08a3c", "#5aae4a", "#ef6f6c", "#8e6bbf"],
  "flash": "#1f3b5a",
  "lights": null,
  "approach": false,
  "thumb": "linear-gradient(180deg,#f6c56a 0%,#7fc4e6 25%,#6cbf5a 50%,#3b8fc9 62%,#f4efdf 76%,#f4efdf 100%)",
  "vars": {
    "--show-font": "\"Fredoka\",\"Avenir Next\",sans-serif",
    "--show-weight": "700",
    "--show-case": "none",
    "--show-track": ".02em",
    "--show-glow": "0 .5cqw 0 #ffffff, 0 0 2cqw rgba(255,255,255,.95), 0 0 6cqw rgba(255,255,255,.8)",
    "--pill-bg": "#2f6f9f",
    "--pill-ink": "#fdf8ec",
    "--pill-edge": "#1f3b5a",
    "--pill-glow": "rgba(91,182,224,.45)",
    "--ui-font": "\"Fredoka\",\"Avenir Next\",sans-serif",
    "--lc-text": "#24384a",
    "--lc-accent": "#f08a3c",
    "--lc-btn-bg": "#2a9d8f",
    "--lc-btn-ink": "#ffffff",
    "--lc-btn-edge": "#1f7a6f",
    "--lc-field-bg": "rgba(255,255,255,.85)",
    "--lc-field-edge": "#9ccbe0"
  }
}

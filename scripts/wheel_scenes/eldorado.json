    "--pill-bg": "#0f3a2e",
    "--pill-ink": "#f3e6c0",
    "--pill-edge": "#d9a531",
    "--pill-glow": "#e8b84a",
    "--ui-font": "\"Cinzel Decorative\",Georgia,serif",
    "--sc-text": "#f3e6c0",
    "--sc-icon": "#e8c46a",
    "--sc-accent": "#e8b84a",
    "--sc-accent2": "#6fd0b0",
    "--sc-muted": "#9fb8a6",
    "--sc-glow": "rgba(232,184,74,.45)",
    "--sc-btn-a": "#e2b44a",
    "--sc-btn-b": "#a8741f",
    "--sc-btn-edge": "#f6dc8c",
    "--sc-btn-ink": "#2a1a05",
    "--shade-rgb": "8, 30, 24",
    "--pool-a": "232, 184, 74",
    "--pool-b": "63, 160, 138",
    "--halo": "rgba(240,200,100,.35)"

{
  "id": "westkingdom",
  "name": "West Kingdom",
  "inspiredBy": "the West Kingdom trilogy",
  "dark": true,
  "gfont": "Alegreya+SC:wght@700",
  "face": {
    "palette": ["#8e1f24", "#1f6a68", "#d9a441", "#22457d", "#5b3a26", "#2f7a52"],
    "seam": "#6b2a5a",
    "ink": "contrast",
    "font": "700 {px} \"Alegreya SC\",Georgia,serif",
    "sep": "#1b130d",
    "sepW": 1.4,
    "rim": "gilt",
    "pins": "iron",
    "hub": "bronze",
    "mark": {"color": "#ffd77a", "glow": "rgba(255,200,90,.9)", "width": 3},
    "stick": ["#6e1418", "#c8343b", "rgba(40,8,10,.85)"]
  },
  "count": ["#ffd77a", "#f2ead6", "#e8604f"],
  "word": ["#ffd77a", "#f2ead6", "#7fd0c8", "#e8604f"],
  "flash": "#ffd77a",
  "lights": {"idle": 0.4, "spin": 0.15, "focus": 0.6, "out": 0.6},
  "approach": true,
  "thumb": "linear-gradient(180deg,#8fb0c8 0%,#c9a46a 40%,#5b3a26 75%,#1b130d 100%)",
  "vars": {
    "--show-font": "\"Alegreya SC\",Georgia,serif",
    "--show-weight": "700",
    "--show-case": "none",
    "--show-track": ".04em",
    "--show-glow": "0 .6cqw 0 rgba(27,19,13,.95), 0 0 1cqw rgba(27,19,13,.9), 0 0 5cqw rgba(255,190,90,.35)",
    "--pill-bg": "#1b130d",
    "--pill-ink": "#ffd77a",
    "--pill-edge": "#c8343b",
    "--pill-glow": "#ffd77a",
    "--ui-font": "\"Alegreya SC\",Georgia,serif",
    "--sc-text": "#f2ead6",
    "--sc-icon": "#f2ead6",
    "--sc-accent": "#ffd77a",
    "--sc-accent2": "#7fd0c8",
    "--sc-muted": "#d6c7a8",
    "--sc-glow": "rgba(255,200,90,.35)",
    "--sc-btn-a": "#a8262c",
    "--sc-btn-b": "#6e1418",
    "--sc-btn-edge": "#ffd77a",
    "--sc-btn-ink": "#fff6e2",
    "--shade-rgb": "20, 12, 8",
    "--pool-a": "255, 222, 170",
    "--pool-b": "255, 245, 225",
    "--halo": "rgba(255,200,110,.3)",
    "--scrim-rgb": "20, 13, 9"
  }
}

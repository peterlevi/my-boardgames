{
  "id": "root",
  "name": "Root",
  "inspiredBy": "Root",
  "dark": false,
  "gfont": "Fraunces:wght@700",
  "face": {
    "palette": ["#d9772b", "#2f5a45", "#efd9a7", "#3d7d7a", "#6e9b57", "#2e4a7a"],
    "ink": "contrast",
    "glow": "rgba(42,28,18,.35)",
    "font": "700 {px} \"Fraunces\",Georgia,serif",
    "sep": "#4a3324",
    "sepW": 1.6,
    "rim": {"color": "#4a3324", "width": 0.02, "glow": "#f1e4c3"},
    "pins": {"color": "#f1e4c3", "glow": "#4a3324"},
    "hub": {"fill": "#4a3324", "ring": "#d9772b", "glow": "#f1e4c3"},
    "mark": {"color": "#fff6dc", "glow": "rgba(42,28,18,.9)", "width": 4},
    "stick": ["#4a3324", "#d9772b", "rgba(42,28,18,.75)"]
  },
  "count": ["#d9772b", "#fff6dc", "#2e4a7a"],
  "word": ["#d9772b", "#2f5a45", "#3d7d7a", "#4a3324", "#6e9b57", "#2e4a7a"],
  "flash": "#fff6dc",
  "lights": null,
  "approach": false,
  "thumb": "linear-gradient(180deg,#f1e4c3 0%,#2f5a45 30%,#6e9b57 60%,#ece3c4 75%,#4f7a4a 100%)",
  "vars": {
    "--show-font": "\"Fraunces\",Georgia,serif",
    "--show-weight": "700",
    "--show-case": "none",
    "--show-track": ".02em",
    "--show-glow": "0 .6cqw 0 #4a3324, 0 0 1.2cqw rgba(42,28,18,.8), 0 0 5cqw rgba(42,28,18,.55)",
    "--pill-bg": "#4a3324",
    "--pill-ink": "#f1e4c3",
    "--pill-edge": "#2a1c12",
    "--pill-glow": "rgba(217,119,43,.45)",
    "--ui-font": "\"Fraunces\",Georgia,serif",
    "--lc-text": "#3b281b",
    "--lc-accent": "#d9772b",
    "--lc-btn-bg": "#4a3324",
    "--lc-btn-ink": "#f6ecd2",
    "--lc-btn-edge": "#2a1c12",
    "--lc-field-bg": "rgba(255,249,234,.88)",
    "--lc-field-edge": "#b89a6e"
  }
}

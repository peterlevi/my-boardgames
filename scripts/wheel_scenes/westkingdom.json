{
  "id": "westkingdom",
  "name": "West Kingdom",
  "inspiredBy": "the West Kingdom trilogy",
  "dark": true,
  "gfont": "Alegreya+SC:wght@700",
  "face": {
    "palette": [
      "#b8401f",
      "#e08a3a",
      "#7a1e1c",
      "#d9a441",
      "#4a2a1c",
      "#c4622d",
      "#2f5f5c"
    ],
    "seam": "#8f2f23",
    "ink": "contrast",
    "font": "700 {px} \"Alegreya SC\",Georgia,serif",
    "sep": "#1b130d",
    "sepW": 1.4,
    "rim": "gilt",
    "pins": "iron",
    "hub": "bronze",
    "mark": {
      "color": "#ffe2a0",
      "glow": "rgba(255,170,80,.95)",
      "width": 3
    },
    "stick": [
      "#5a1410",
      "#d8432f",
      "rgba(30,8,6,.85)"
    ]
  },
  "count": [
    "#ffd08a",
    "#fff0d6",
    "#ff8a5c"
  ],
  "word": [
    "#ffd08a",
    "#fff0d6",
    "#ff8a5c",
    "#f2b44a"
  ],
  "flash": "#ffd08a",
  "lights": {
    "idle": 0.4,
    "spin": 0.15,
    "focus": 0.6,
    "out": 0.6
  },
  "approach": true,
  "thumb": "linear-gradient(180deg,#e0742f 0%,#b8401f 45%,#4a2a1c 80%,#1c0f0a 100%)",
  "vars": {
    "--show-font": "\"Alegreya SC\",Georgia,serif",
    "--show-weight": "700",
    "--show-case": "none",
    "--show-track": ".04em",
    "--show-glow": "0 .6cqw 0 rgba(28,12,6,.95), 0 0 1cqw rgba(28,12,6,.9), 0 0 5cqw rgba(255,140,60,.45)",
    "--pill-bg": "#1c0f0a",
    "--pill-ink": "#ffd08a",
    "--pill-edge": "#e0742f",
    "--pill-glow": "#ff9a4a",
    "--ui-font": "\"Alegreya SC\",Georgia,serif",
    "--sc-text": "#f2ead6",
    "--sc-icon": "#f2ead6",
    "--sc-accent": "#ffb366",
    "--sc-accent2": "#ffd08a",
    "--sc-muted": "#e6c9ad",
    "--sc-glow": "rgba(255,150,70,.4)",
    "--sc-btn-a": "#c4482a",
    "--sc-btn-b": "#7a1e1c",
    "--sc-btn-edge": "#ffb366",
    "--sc-btn-ink": "#fff6e2",
    "--shade-rgb": "28, 12, 6",
    "--pool-a": "255, 200, 140",
    "--pool-b": "255, 230, 200",
    "--halo": "rgba(255,140,60,.35)",
    "--scrim-rgb": "28, 14, 8"
  }
}
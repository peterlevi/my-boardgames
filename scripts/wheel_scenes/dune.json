{
  "id": "dune",
  "name": "Dune",
  "inspiredBy": "Dune: Imperium",
  "dark": true,
  "gfont": "Josefin+Sans:wght@700",
  "face": {
    "palette": ["#c4561f", "#2a2350", "#e08a3c", "#5a2a1e", "#d9b27a", "#3b3d6e"],
    "seam": "#8a3a1c",
    "ink": "contrast",
    "glow": "rgba(20,10,24,.45)",
    "font": "700 {px} \"Josefin Sans\",Arial,sans-serif",
    "sep": "#1a1020",
    "sepW": 1.2,
    "rim": "copper",
    "pins": "bronze",
    "hub": "iron",
    "mark": {"color": "#7ff3ff", "glow": "rgba(80,220,255,.85)", "width": 3},
    "stick": ["#4a2a1a", "#f0a050", "rgba(15,8,20,.85)"]
  },
  "count": ["#ffb25a", "#7ff3ff", "#ff7a3a"],
  "word": ["#ffb25a", "#e8d2a8", "#7ff3ff", "#ff7a3a"],
  "flash": "#ffd08a",
  "lights": {"idle": 0.5, "spin": 0.18, "focus": 0.65, "out": 0.62},
  "approach": true,
  "thumb": "linear-gradient(180deg,#0a0a2a 0%,#3e2556 30%,#7a3448 42%,#c4561f 52%,#ec9548 58%,#5a2218 66%,#22100f 76%,#140a10 100%)",
  "vars": {
    "--show-font": "\"Josefin Sans\",Arial,sans-serif",
    "--show-weight": "700",
    "--show-case": "uppercase",
    "--show-track": ".12em",
    "--show-glow": "0 .5cqw 0 rgba(20,10,24,.85), 0 0 3cqw rgba(255,150,70,.5), 0 0 6cqw rgba(20,10,24,.6)",
    "--pill-bg": "#2a1420",
    "--pill-ink": "#ffc38a",
    "--pill-edge": "#c46a32",
    "--pill-glow": "#f0a050",
    "--ui-font": "\"Josefin Sans\",Arial,sans-serif",
    "--sc-text": "#f3dcc0",
    "--sc-icon": "#f0a050",
    "--sc-accent": "#f0a050",
    "--sc-accent2": "#7ff3ff",
    "--sc-muted": "#b49482",
    "--sc-glow": "rgba(240,160,80,.45)",
    "--sc-btn-a": "#e8893a",
    "--sc-btn-b": "#9c3418",
    "--sc-btn-edge": "#ffc38a",
    "--sc-btn-ink": "#1a0d10",
    "--shade-rgb": "18, 10, 22",
    "--pool-a": "240, 150, 70",
    "--pool-b": "120, 230, 255",
    "--halo": "rgba(255,160,80,.3)"
  }
}
